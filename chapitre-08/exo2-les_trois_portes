Message : erreur : 'int Base::protegee' est protege dans ce contexte
Pourquoi : protected veut dire accessible seulement depuis Base et ses classes derivees. soigner est une fonction libre, elle n'est ni Base ni Derivee, donc elle n'a pas le droit, meme si elle recoit un Base& en parametre.
#include <cstdio>
class Base {
public:
    int publique;
protected:
    int protegee;
private:
    int privee;
};
class Derivee : public Base {
public:
    void afficher() {
        printf("%d\n", publique); 
        printf("%d\n", protegee); 
        // printf("%d\n", privee); 
    }
};
void soigner(Base& b) {
    // b.protegee = 9; 
    b.publique = 9;
}
int main() {
    Derivee d;
    d.afficher();
    printf("%d\n", d.publique);
    // printf("%d\n", d.protegee); 
    // printf("%d\n", d.privee);  
    Base b;
    soigner(b);

return 0;
}
